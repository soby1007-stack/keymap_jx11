<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 앱의 '무선 디버깅 페어링 코드' 창에서 6자리 코드를 읽어 오는 용도로만 쓴다. 제조사 설정 앱의 패키지명이 다를 수 있어 XML 로는 제한하지 않고, 코드에서 '설정 앱' 창만 읽는다 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/pair_accessibility_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="150" />
